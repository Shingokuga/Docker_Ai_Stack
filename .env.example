# .env.example — copier en .env (généré par install.sh). Ne JAMAIS commiter .env.
# Stack Universelle d'IA — 24 services Docker Compose avec GPU NVIDIA

# MARK: Stack Core
# Nom du projet compose (utilisé pour le préfixe des conteneurs/réseaux)
COMPOSE_PROJECT_NAME=ustack
# Domaine de base des URLs (https://<nom>.BASE_DOMAIN)
BASE_DOMAIN=local
# Fuseau horaire
TZ=Europe/Paris
# Répertoire des données persistantes (bind mounts)
DATA_DIR=./data

# MARK: DNS / Domain
# Ports publiés par Caddy (seuls ports ouverts sur l'hôte)
HTTP_PORT=80
HTTPS_PORT=443

# MARK: GPU Configuration
# Palier GPU : S | M | L
GPU_TIER=M

# MARK: AI Models
# Nom du fichier GGUF chat dans DATA_DIR/models
LLM_GGUF=
# Nom du fichier mmproj (vision) dans DATA_DIR/models
LLM_MMPROJ=mmproj-F16.gguf
# Taille de contexte llama-server
LLM_CTX=32768
# Nom de modèle exposé par LiteLLM
LLM_ALIAS=chat
# Modèle d'embeddings Ollama (ne JAMAIS changer après déploiement client)
EMBED_MODEL=embeddinggemma-2:latest
# Modèle de décision Ollama (n8n)
DECISION_MODEL=kev:9b-q4_K_M
# Modèle Whisper (STT, dépôt Hugging Face au format faster-whisper/CTranslate2)
WHISPER_MODEL=Systran/faster-whisper-large-v3
# Voix Kokoro par défaut (TTS) — ff_siwis = voix française
KOKORO_VOICE_DEFAULT=ff_siwis

# MARK: Services
# URL de base ComfyUI (interne uniquement)
COMFYUI_BASE_URL=http://comfyui:8188

# MARK: Security
# Mot de passe du superuser Postgres (URL-safe: hex, utilisé dans DATABASE_URL)
POSTGRES_PASSWORD=
# Mot de passe Redis
REDIS_PASSWORD=
# Clé API Qdrant
QDRANT_API_KEY=
# Clé maître LiteLLM (sk-...)
LITELLM_MASTER_KEY=
# Sel de chiffrement LiteLLM (ne pas changer après déploiement)
LITELLM_SALT_KEY=
# Clé secrète Open WebUI
WEBUI_SECRET_KEY=
# Clé de chiffrement n8n (ne pas changer après déploiement)
N8N_ENCRYPTION_KEY=
# Secret NextAuth (Langfuse)
NEXTAUTH_SECRET=
# Sel Langfuse
LANGFUSE_SALT=
# Clé de chiffrement Langfuse (64 caractères hex)
LANGFUSE_ENCRYPTION_KEY=
# Mot de passe ClickHouse
CLICKHOUSE_PASSWORD=
# Utilisateur root S3 (RustFS)
S3_ROOT_USER=
# Mot de passe root S3 (RustFS)
S3_ROOT_PASSWORD=
# Secret SearXNG
SEARXNG_SECRET=
# Token CDP Obscura (>= 32 octets; endpoint: ws://obscura:9222)
OBSCURA_CDP_TOKEN=
# Token MCP Obscura (>= 32 octets; endpoint MCP interne: http://obscura-mcp:3000/mcp)
OBSCURA_MCP_TOKEN=

# MARK: Storage
# (les répertoires de données sont gérés via DATA_DIR)

# MARK: Monitoring
# (Grafana/Prometheus/Loki utilisent les defaults)

# MARK: Notifications
# (Slack/PagerDuty configurables dans les dashboards Grafana)

# MARK: Open WebUI
# Email du compte admin (créé au 1er démarrage si base vide)
WEBUI_ADMIN_EMAIL=
# Mot de passe du compte admin (>= 24 caractères)
WEBUI_ADMIN_PASSWORD=
# Clé API Context7 (optionnelle; vide = connexion Context7 désactivée)
# Clé gratuite sur: https://context7.com/dashboard
CONTEXT7_API_KEY=

# MARK: Langfuse init
# ID de l'organisation Langfuse
LANGFUSE_INIT_ORG_ID=
# ID du projet Langfuse
LANGFUSE_INIT_PROJECT_ID=
# Clé publique du projet (pk-lf-...)
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
# Clé secrète du projet (sk-lf-...)
LANGFUSE_INIT_PROJECT_SECRET_KEY=
# E-mail du compte admin Langfuse
LANGFUSE_INIT_USER_EMAIL=
# Mot de passe du compte admin Langfuse
LANGFUSE_INIT_USER_PASSWORD=
