http://certificat.{$BASE_DOMAIN} {
    handle /root.crt {
        root * /data/caddy/pki/authorities/local
        rewrite * /root.crt
        header Content-Type "application/x-x509-ca-cert"
        header Content-Disposition "attachment; filename=root.crt"
        file_server
    }
    handle {
        root * /srv/certificat
        file_server
    }
}
