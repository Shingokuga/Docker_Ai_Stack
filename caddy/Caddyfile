{
    skip_install_trust
}

chat-ai.{$BASE_DOMAIN} {
    tls internal
    encode zstd gzip
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    reverse_proxy open-webui:8080
}

