# ============================================================
# versions.env — TOUTES les images, tags EXACTS (jamais latest/main/nightly).
# Seul fichier modifié par une release. Vérifié le 2026-10-30 (docker manifest inspect, linux/amd64).
# ============================================================

# ---- Lot A2 : noyau (vérifiés) ----
IMG_POSTGRES=postgres:17.11
IMG_REDIS=redis:7.4.12
IMG_QDRANT=qdrant/qdrant:v1.20.0
IMG_OLLAMA=ollama/ollama:0.40.13
IMG_LLAMA=ghcr.io/ggml-org/llama.cpp:server-cuda-b11206
IMG_LITELLM=ghcr.io/berriai/litellm:v1.106.6

# ---- Lot A3 : apps part 1 (vérifiés 2026-10-30, linux/amd64) ----
IMG_OPENWEBUI=ghcr.io/open-webui/open-webui:v0.12.5
IMG_N8N=docker.n8n.io/n8nio/n8n:2.45.6
# cu128 (Blackwell + Ada/Ampere). cu126 est gelé à v1.12.0: docling-serve-cu126:v1.38.2 N'EXISTE PAS.
IMG_DOCLING=ghcr.io/docling-project/docling-serve-cu128:v1.38.2

# ---- Lot A4 : voix, observabilité, stockage (vérifiés 2026-10-30, linux/amd64) ----
# Kokoro: v0.9.1 (sans suffixe) = wheels cu126 (pas de kernels Blackwell sm_120); -cu128 = même release, amd64 seul.
# (v0.9.2 publiée le 2026-10-30, non retenue: trop récente.)
IMG_KOKORO=ghcr.io/remsky/kokoro-fastapi-gpu:v0.9.1-cu128
# speaches (faster-whisper, API OpenAI). Dernière release stable = 0.8.3 (0.9.0 n'existe qu'en rc). Variante CUDA 12.6.3.
IMG_WHISPER=ghcr.io/speaches-ai/speaches:0.8.3-cuda-12.6.3
IMG_CLICKHOUSE=clickhouse/clickhouse-server:25.12.11.4
IMG_S3=rustfs/rustfs:1.0.4
# Image du one-shot s3-init (création du bucket langfuse)
IMG_S3_INIT=amazon/aws-cli:2.39.2
IMG_LANGFUSE_WEB=docker.langfuse.com/langfuse/langfuse:4.72.0
IMG_LANGFUSE_WORKER=docker.langfuse.com/langfuse/langfuse-worker:4.72.0

# ---- Lot A1/A3 : reste ----
IMG_SEARXNG=searxng/searxng:2026.10.30-1cd13d98d
IMG_PORTAINER=portainer/portainer-ce:2.45.3
IMG_CADDY=caddy:2.11.7
IMG_OBSCURA=h4ckf0r0day/obscura:0.2.5
