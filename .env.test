# .env.example — copier en .env (généré par install.sh). Ne JAMAIS commiter .env.

# ---- Config générale ----
# Nom du projet compose
COMPOSE_PROJECT_NAME=ustack
# Domaine de base des URLs (https://<nom>.BASE_DOMAIN)
BASE_DOMAIN=local
# Ports publiés par Caddy (seuls ports ouverts sur l'hôte)
HTTP_PORT=80
HTTPS_PORT=443
# Fuseau horaire
TZ=Europe/Paris
# Répertoire des données persistantes (bind mounts)
DATA_DIR=./data

# ---- Modèles / GPU ----
# Palier GPU : S | M | L
GPU_TIER=M
# Nom du fichier GGUF chat dans DATA_DIR/models
LLM_GGUF=
# Nom du fichier mmproj (vision) dans DATA_DIR/models
LLM_MMPROJ=mmproj-F16.gguf
# Taille de contexte llama-server
LLM_CTX=32768
# Nom de modèle exposé par LiteLLM
LLM_ALIAS=chat
# Modèle d'embeddings Ollama (ne JAMAIS changer après déploiement client)
EMBED_MODEL=embeddinggemma-2:latest
# Modèle de décision Ollama (n8n)
DECISION_MODEL=kev:9b-q4_K_M
# Modèle Whisper (STT, dépôt Hugging Face au format faster-whisper/CTranslate2)
WHISPER_MODEL=Systran/faster-whisper-large-v3
# Voix Kokoro par défaut (TTS) — ff_siwis = voix française
KOKORO_VOICE_DEFAULT=ff_siwis

# ---- Secrets (32+ caractères aléatoires, openssl rand) ----
