#!/usr/bin/env bash
cd "$(dirname "$(readlink -f "$0")")"

if [ "$1" = "doctor" ]; then
    # ===== STACK DOCTOR =====
    # Diagnostic en lecture seule : ce bloc ne modifie ni les conteneurs, ni les images,
    # ni les fichiers du dépôt. Tous les appels compose passent par compose_cmd, avec les
    # mêmes fichiers d'environnement que le passe-plat de la dernière ligne du script.
    CRITICAL=0
    WARNINGS=0
    OK_COUNT=0

    ok() { echo "  ✅ $1"; OK_COUNT=$((OK_COUNT + 1)); }
    fail() { echo "  ❌ $1"; CRITICAL=$((CRITICAL + 1)); }
    warn() { echo "  ⚠️  $1"; WARNINGS=$((WARNINGS + 1)); }
    info() { echo "  ℹ️  $1"; }

    compose_cmd() { docker compose --env-file versions.env --env-file .env "$@"; }

    # Première ligne utile d'un message d'erreur (les lignes WARN sont ignorées).
    first_error_line() {
        local line
        line=$(printf '%s\n' "$1" | sed -n '/^[[:space:]]*WARN/d;/level=warn/d;/^[[:space:]]*$/d;p;q')
        [ -n "$line" ] || line=$(printf '%s\n' "$1" | sed -n '1p')
        printf '%s' "$line"
    }

    # Outil de lecture JSON : jq, à défaut python3.
    JSON_TOOL=""
    if command -v jq >/dev/null 2>&1; then
        JSON_TOOL="jq"
    elif command -v python3 >/dev/null 2>&1; then
        JSON_TOOL="python3"
    fi

    # Config compose (JSON sur stdin) -> lignes "I|service|image" et "U|service|protocole|port publié".
    json_config_rows() {
        if [ "$JSON_TOOL" = "jq" ]; then
            jq -r '
                .services
                | if type == "object" then . else error("services") end
                | to_entries[]
                | .key as $s
                | .value as $v
                | (if ($v.image // "") != "" then "I|\($s)|\($v.image)" else empty end),
                  (($v.ports // [])[]
                   | select(type == "object" and ((.published // "") | tostring) != "")
                   | "U|\($s)|\(.protocol // "tcp")|\(.published)")
            '
        elif [ "$JSON_TOOL" = "python3" ]; then
            python3 -c '
import json, sys
data = json.load(sys.stdin)
services = data["services"]
if not isinstance(services, dict):
    raise SystemExit(1)
for name, svc in services.items():
    if not isinstance(svc, dict):
        continue
    image = svc.get("image") or ""
    if image:
        print("I|%s|%s" % (name, image))
    for port in svc.get("ports") or []:
        if isinstance(port, dict) and str(port.get("published") or "") != "":
            print("U|%s|%s|%s" % (name, port.get("protocol") or "tcp", port["published"]))
'
        else
            return 1
        fi
    }

    # Sortie de ps --format json (JSON ligne à ligne ou tableau, sur stdin)
    # -> lignes "C|service|état|santé|image" et "P|protocole|port publié" (conteneurs running).
    json_ps_rows() {
        if [ "$JSON_TOOL" = "jq" ]; then
            jq -r -s '
                flatten
                | .[]
                | select(type == "object")
                | "C|\(.Service // "")|\(.State // "")|\(.Health // "")|\(.Image // "")",
                  (if (.State // "") == "running"
                   then ((.Publishers // [])[]
                         | select((.PublishedPort // 0) > 0)
                         | "P|\(.Protocol // "tcp")|\(.PublishedPort)")
                   else empty end)
            '
        elif [ "$JSON_TOOL" = "python3" ]; then
            python3 -c '
import json, sys
raw = sys.stdin.read().strip()
items = []
if raw:
    try:
        data = json.loads(raw)
        items = data if isinstance(data, list) else [data]
    except ValueError:
        items = [json.loads(line) for line in raw.splitlines() if line.strip()]
for c in items:
    if not isinstance(c, dict):
        continue
    state = c.get("State") or ""
    print("C|%s|%s|%s|%s" % (c.get("Service") or "", state, c.get("Health") or "", c.get("Image") or ""))
    if state == "running":
        for p in c.get("Publishers") or []:
            if isinstance(p, dict) and int(p.get("PublishedPort") or 0) > 0:
                print("P|%s|%s" % (p.get("Protocol") or "tcp", p["PublishedPort"]))
'
        else
            return 1
        fi
    }

    # Port à l'écoute sur l'hôte ? Retour : 0 = occupé, 1 = libre, 2 = indéterminé.
    port_in_use() {
        local proto="$1" port="$2" flag="-tln" out
        [ "$proto" = "udp" ] && flag="-uln"
        if command -v ss >/dev/null 2>&1; then
            out=$(ss -H "$flag" "( sport = :${port} )" 2>/dev/null) || return 2
        elif command -v netstat >/dev/null 2>&1; then
            out=$(netstat "$flag" 2>/dev/null | awk -v suffix=":${port}" 'substr($4, length($4) - length(suffix) + 1) == suffix') || return 2
        else
            return 2
        fi
        [ -n "$out" ]
    }

    # Port publié par un conteneur en cours de ce projet compose ?
    stack_holds_port() {
        printf '%s\n' "$PS_ROWS" | awk -F'|' -v proto="$1" -v port="$2" '$1 == "P" && $2 == proto && $3 == port { found = 1 } END { exit !found }'
    }

    echo "🏥 Stack Doctor — diagnostic complet"
    echo "===================================="
    echo ""

    # Check 1: Docker installed
    echo "🔍 Docker installation"
    HAVE_DOCKER=0
    if command -v docker >/dev/null 2>&1; then
        HAVE_DOCKER=1
        DOCKER_VER=$(docker --version 2>&1 | sed 's/^Docker version //;s/, .*//')
        ok "Docker installed (v${DOCKER_VER:-unknown})"
    else
        fail "Docker not installed or not in PATH"
    fi

    # Check 2: Docker Compose installed
    echo "🔍 Docker Compose installation"
    if compose_cmd version >/dev/null 2>&1; then
        COMPOSE_VER=$(compose_cmd version --short 2>&1)
        ok "Docker Compose installed (${COMPOSE_VER:-unknown})"
    elif command -v docker-compose >/dev/null 2>&1; then
        ok "docker-compose (standalone) installed"
    else
        fail "Docker Compose not installed"
    fi

    # Check 3: docker-compose.yml parsable (même commande que ./stack config -q)
    echo "🔍 docker-compose.yml validation"
    CFG_OK=0
    if [ ! -f .env ]; then
        # Sans .env, les variables obligatoires manquent : contrôle de syntaxe YAML seul
        if python3 -c "import yaml" >/dev/null 2>&1; then
            if python3 -c "import yaml; yaml.safe_load(open('docker-compose.yml'))" >/dev/null 2>&1; then
                ok "docker-compose.yml is valid (syntax check, .env missing)"
            else
                fail "docker-compose.yml has syntax errors"
            fi
        else
            info "PyYAML absent : syntaxe de docker-compose.yml non vérifiée (.env missing)"
        fi
    elif [ "$HAVE_DOCKER" -ne 1 ]; then
        info "docker absent : docker-compose.yml non validé"
    elif CFG_ERR=$(compose_cmd config -q 2>&1 >/dev/null); then
        CFG_OK=1
        ok "docker-compose.yml is valid"
    else
        CFG_LINE=$(first_error_line "$CFG_ERR")
        fail "docker-compose.yml has errors: ${CFG_LINE:-(no error message)}"
    fi

    # État lu une seule fois : config compose résolue et conteneurs en cours (JSON).
    CFG_ROWS=""
    PS_ROWS=""
    CFG_READ=0
    PS_READ=0
    STATE_REASON=""
    if [ "$HAVE_DOCKER" -ne 1 ]; then
        STATE_REASON="docker absent"
    elif [ ! -f .env ]; then
        STATE_REASON=".env absent"
    elif [ "$CFG_OK" -ne 1 ]; then
        STATE_REASON="docker-compose.yml invalide"
    elif [ -z "$JSON_TOOL" ]; then
        STATE_REASON="jq et python3 absents"
    else
        if CFG_JSON=$(compose_cmd config --format json 2>/dev/null) &&
            CFG_ROWS=$(printf '%s\n' "$CFG_JSON" | json_config_rows 2>/dev/null); then
            CFG_READ=1
        fi
        if PS_JSON=$(compose_cmd ps --format json 2>/dev/null) &&
            PS_ROWS=$(printf '%s\n' "$PS_JSON" | json_ps_rows 2>/dev/null); then
            PS_READ=1
        fi
    fi
    CFG_WHY="${STATE_REASON:-config --format json illisible}"
    PS_WHY="${STATE_REASON:-ps --format json illisible, démon Docker injoignable ?}"

    # Check 4: .env exists and has required variables
    echo "🔍 .env file and required variables"
    if [ ! -f .env ]; then
        fail ".env file not found"
    else
        ok ".env file exists"
        # Check required variables from .env.example
        MISSING=""
        while IFS='=' read -r var _; do
            var=$(echo "$var" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
            case "$var" in
                ""|\#*) continue ;;
            esac
            if ! /usr/bin/grep -q "^${var}=" .env; then
                MISSING="${MISSING} ${var}"
            fi
        done < .env.example
        if [ -z "$MISSING" ]; then
            ok "All required .env variables are set"
        else
            warn "Missing .env variables:${MISSING}"
        fi
    fi

    # Check 5: versions.env exists
    echo "🔍 versions.env file"
    if [ ! -f versions.env ]; then
        fail "versions.env file not found"
    else
        ok "versions.env file exists"
    fi

    # Check 6: images des conteneurs en cours = images résolues par le compose (versions.env)
    echo "🔍 Docker image versions"
    if [ "$CFG_READ" -ne 1 ] || [ "$PS_READ" -ne 1 ]; then
        if [ "$CFG_READ" -ne 1 ]; then
            info "comparaison impossible : ${CFG_WHY}"
        else
            info "comparaison impossible : ${PS_WHY}"
        fi
    else
        PS_COUNT=$(printf '%s\n' "$PS_ROWS" | awk -F'|' '$1 == "C" { n++ } END { print n + 0 }')
        if [ "$PS_COUNT" -eq 0 ]; then
            info "aucun conteneur, pas de comparaison"
        else
            IMG_COMPARED=0
            IMG_DIFF=0
            IMG_SKIPPED=0
            while IFS='|' read -r kind svc _ _ image; do
                [ "$kind" = "C" ] || continue
                expected=$(printf '%s\n' "$CFG_ROWS" | awk -F'|' -v svc="$svc" '$1 == "I" && $2 == svc { print $3; exit }')
                if [ -z "$expected" ]; then
                    IMG_SKIPPED=$((IMG_SKIPPED + 1))
                    continue
                fi
                IMG_COMPARED=$((IMG_COMPARED + 1))
                if [ "$image" != "$expected" ]; then
                    IMG_DIFF=$((IMG_DIFF + 1))
                    warn "${svc} : image en cours ${image}, attendue ${expected} (versions.env)"
                fi
            done <<< "$PS_ROWS"
            if [ "$IMG_COMPARED" -eq 0 ]; then
                info "aucune image comparable (services en cours absents de la config)"
            elif [ "$IMG_DIFF" -eq 0 ]; then
                ok "${IMG_COMPARED} image(s) en cours conforme(s) à versions.env"
            fi
            if [ "$IMG_SKIPPED" -gt 0 ]; then
                info "${IMG_SKIPPED} conteneur(s) sans image dans la config, non comparé(s)"
            fi
        fi
    fi

    # Check 7: Ports are free
    echo "🔍 Port availability"
    if [ "$CFG_READ" -ne 1 ]; then
        info "ports non vérifiés : ${CFG_WHY}"
    else
        # Ports publiés par la config (plages développées), une ligne par port : protocole|port|services
        PORT_ROWS=$(printf '%s\n' "$CFG_ROWS" | awk -F'|' '
            $1 == "U" {
                n = split($4, bounds, "-")
                lo = bounds[1] + 0
                hi = (n > 1) ? bounds[2] + 0 : lo
                if (lo < 1 || hi < lo) next
                if (hi > lo + 63) hi = lo + 63
                for (p = lo; p <= hi; p++) {
                    key = $3 "|" p
                    if (!(key in svcs)) {
                        order[++count] = key
                        svcs[key] = $2
                    } else if (index("," svcs[key] ",", "," $2 ",") == 0) {
                        svcs[key] = svcs[key] "," $2
                    }
                }
            }
            END { for (i = 1; i <= count; i++) print order[i] "|" svcs[order[i]] }
        ')
        if [ -z "$PORT_ROWS" ]; then
            ok "No published ports detected (internal network only)"
        else
            while IFS='|' read -r PORT_PROTO PORT_NUM PORT_SVCS; do
                [ -n "$PORT_NUM" ] || continue
                PORT_LABEL="port ${PORT_NUM}"
                [ "$PORT_PROTO" = "udp" ] && PORT_LABEL="port ${PORT_NUM}/udp"
                port_in_use "$PORT_PROTO" "$PORT_NUM"
                case $? in
                    1) ok "${PORT_LABEL} libre (requis par ${PORT_SVCS})" ;;
                    0)
                        if stack_holds_port "$PORT_PROTO" "$PORT_NUM"; then
                            ok "${PORT_LABEL} tenu par la stack (${PORT_SVCS})"
                        else
                            warn "${PORT_LABEL} occupé par un autre processus (requis par ${PORT_SVCS})"
                        fi
                        ;;
                    *) info "${PORT_LABEL} : état indéterminé (ss et netstat absents)" ;;
                esac
            done <<< "$PORT_ROWS"
        fi
    fi

    # Check 8: Volumes exist
    echo "🔍 Volume directories"
    # Check data directories
    if [ -d "data" ]; then
        ok "data/ directory exists"
    else
        warn "data/ directory not found (will be created on first run)"
    fi

    # Check 9: Container health (if running)
    echo "🔍 Container health"
    if [ "$PS_READ" -ne 1 ]; then
        info "état des conteneurs indisponible : ${PS_WHY}"
    else
        RUNNING=$(printf '%s\n' "$PS_ROWS" | awk -F'|' '$1 == "C" && $3 == "running" { n++ } END { print n + 0 }')
        if [ "$RUNNING" -eq 0 ]; then
            info "No containers running (stack is down)"
        else
            UNHEALTHY=$(printf '%s\n' "$PS_ROWS" | awk -F'|' '$1 == "C" && $4 == "unhealthy" { n++ } END { print n + 0 }')
            if [ "$UNHEALTHY" -eq 0 ]; then
                ok "All ${RUNNING} running containers are healthy"
            else
                UNHEALTHY_NAMES=$(printf '%s\n' "$PS_ROWS" | awk -F'|' '$1 == "C" && $4 == "unhealthy" { printf "%s%s", (k++ ? ", " : ""), $2 } END { print "" }')
                fail "${UNHEALTHY} containers are unhealthy: ${UNHEALTHY_NAMES}"
            fi
        fi
    fi

    # Check 10: SSL certificates
    echo "🔍 SSL certificates"
    if [ -f "caddy/Caddyfile" ]; then
        ok "Caddyfile exists"
    else
        warn "Caddyfile not found"
    fi
    # Certificat racine local de Caddy (lecture seule dans le conteneur) : expire dans plus de 30 jours ?
    if [ "$PS_READ" -ne 1 ]; then
        info "certificat non vérifié : ${PS_WHY}"
    elif ! printf '%s\n' "$PS_ROWS" | awk -F'|' '$1 == "C" && $2 == "caddy" && $3 == "running" { found = 1 } END { exit !found }'; then
        warn "caddy arrêté, certificat non vérifié"
    elif ! command -v openssl >/dev/null 2>&1; then
        warn "openssl absent, certificat non vérifié"
    else
        CA_PATH="/data/caddy/pki/authorities/local/root.crt"
        if CA_PEM=$(compose_cmd exec -T caddy cat "$CA_PATH" 2>/dev/null </dev/null) &&
            CA_END=$(printf '%s\n' "$CA_PEM" | openssl x509 -noout -enddate 2>/dev/null); then
            CA_END="${CA_END#notAfter=}"
            if printf '%s\n' "$CA_PEM" | openssl x509 -noout -checkend 2592000 >/dev/null 2>&1; then
                ok "certificat racine local valide plus de 30 jours (expire le ${CA_END})"
            elif printf '%s\n' "$CA_PEM" | openssl x509 -noout -checkend 0 >/dev/null 2>&1; then
                warn "certificat racine local : expire dans moins de 30 jours (le ${CA_END})"
            else
                fail "certificat racine local expiré (le ${CA_END})"
            fi
        else
            warn "certificat racine local illisible (${CA_PATH}), non vérifié"
        fi
    fi

    # Check 11: Secrets are generated
    echo "🔍 Secret tokens"
    if [ -f ".env" ]; then
        if /usr/bin/grep -q "^OBSCURA_CDP_TOKEN=" .env && ! /usr/bin/grep -q "^OBSCURA_CDP_TOKEN=$" .env; then
            ok "OBSCURA_CDP_TOKEN is set"
        else
            warn "OBSCURA_CDP_TOKEN not set or empty"
        fi
        if /usr/bin/grep -q "^OBSCURA_MCP_TOKEN=" .env && ! /usr/bin/grep -q "^OBSCURA_MCP_TOKEN=$" .env; then
            ok "OBSCURA_MCP_TOKEN is set"
        else
            warn "OBSCURA_MCP_TOKEN not set or empty"
        fi
    else
        info ".env absent : jetons non vérifiés"
    fi

    echo ""
    echo "===================================="
    echo "📊 Summary"
    echo "===================================="
    echo "  ✅ OK:        ${OK_COUNT}"
    echo "  ⚠️  Warnings: ${WARNINGS}"
    echo "  ❌ Critical:  ${CRITICAL}"
    echo ""

    if [ "$CRITICAL" -gt 0 ]; then
        echo "Stack doctor found ${CRITICAL} critical issue(s). Fix before deploying."
        exit 1
    elif [ "$WARNINGS" -gt 0 ]; then
        echo "Stack doctor found ${WARNINGS} warning(s). Review recommended."
        exit 0
    else
        echo "Stack doctor: all checks passed!"
        exit 0
    fi
fi

# ==========================================================================
# ./stack versions  — versions déclarées + conteneurs en cours
# ./stack update    — mise à jour réelle (recherche, écriture, rollback)
# ==========================================================================

# --- Table de correspondance service Compose -> variable IMG_ -------------
# Source : docker-compose.yml. Une variable peut piloter plusieurs services
# (ollama/ollama-init, n8n/n8n-worker, obscura/obscura-mcp).
SERVICE_IMG_MAP=(
    "postgres=IMG_POSTGRES"
    "redis=IMG_REDIS"
    "qdrant=IMG_QDRANT"
    "ollama=IMG_OLLAMA"
    "ollama-init=IMG_OLLAMA"
    "llama-server=IMG_LLAMA"
    "litellm=IMG_LITELLM"
    "open-webui=IMG_OPENWEBUI"
    "n8n=IMG_N8N"
    "n8n-worker=IMG_N8N"
    "docling-serve=IMG_DOCLING"
    "searxng=IMG_SEARXNG"
    "portainer=IMG_PORTAINER"
    "caddy=IMG_CADDY"
    "obscura=IMG_OBSCURA"
    "obscura-mcp=IMG_OBSCURA"
    "kokoro=IMG_KOKORO"
    "whisper=IMG_WHISPER"
    "clickhouse=IMG_CLICKHOUSE"
    "s3=IMG_S3"
    "s3-init=IMG_S3_INIT"
    "langfuse-worker=IMG_LANGFUSE_WORKER"
    "langfuse-web=IMG_LANGFUSE_WEB"
)

# --- Variables IMG_ attendues (une par ligne) ----------------------------
# Contrôle de couverture : toute variable IMG_ de versions.env doit être
# pilotée par la table ci-dessus, sinon la mise à jour l'ignorerait en silence.
EXPECTED_IMG_VARS="IMG_POSTGRES
IMG_REDIS
IMG_QDRANT
IMG_OLLAMA
IMG_LLAMA
IMG_LITELLM
IMG_OPENWEBUI
IMG_N8N
IMG_DOCLING
IMG_KOKORO
IMG_WHISPER
IMG_CLICKHOUSE
IMG_S3
IMG_S3_INIT
IMG_LANGFUSE_WEB
IMG_LANGFUSE_WORKER
IMG_SEARXNG
IMG_PORTAINER
IMG_CADDY
IMG_OBSCURA"

# Listes globales de travail (remplies par cmd_update).
UPDATE_TARGETS=()
UPDATE_CHANGED_SERVICES=()
UPDATED_VARS=()
SAME_MAJOR_ONLY=0

# Outil JSON : jq, à défaut python3.
JSON_TOOL=""
if command -v jq >/dev/null 2>&1; then
    JSON_TOOL="jq"
elif command -v python3 >/dev/null 2>&1; then
    JSON_TOOL="python3"
fi

# Tags d'une réponse JSON de registre (une ligne par tag).
json_tags() {
    if [ "$JSON_TOOL" = "jq" ]; then
        jq -r '.tags[]? // empty' 2>/dev/null
    elif [ "$JSON_TOOL" = "python3" ]; then
        python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for tag in (data.get('tags') or []):
    print(tag)
" 2>/dev/null
    else
        return 1
    fi
}

# Noms de tags d'une réponse de l'API Docker Hub.
json_hub_tags() {
    if [ "$JSON_TOOL" = "jq" ]; then
        jq -r '.results[]?.name' 2>/dev/null
    elif [ "$JSON_TOOL" = "python3" ]; then
        python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for item in (data.get('results') or []):
    name = item.get('name')
    if name:
        print(name)
" 2>/dev/null
    else
        return 1
    fi
}

# La réponse de l'API Hub annonce-t-elle une page suivante ?
json_hub_has_next() {
    if [ "$JSON_TOOL" = "jq" ]; then
        jq -e '.next != null' >/dev/null 2>&1
    elif [ "$JSON_TOOL" = "python3" ]; then
        python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(1)
sys.exit(0 if data.get('next') else 1)
" >/dev/null 2>&1
    else
        return 1
    fi
}

# Jeton d'accès anonyme renvoyé par le realm du registre.
json_token() {
    if [ "$JSON_TOOL" = "jq" ]; then
        jq -r '.token // .access_token // empty' 2>/dev/null
    elif [ "$JSON_TOOL" = "python3" ]; then
        python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
print(data.get('token') or data.get('access_token') or '')
" 2>/dev/null
    else
        return 1
    fi
}

# Valeur d'une variable dans un fichier .env (lecture stricte, sans source).
env_file_value() {
    local file="$1" var="$2" line
    line=$(/usr/bin/grep -m1 "^${var}=" "$file" 2>/dev/null) || return 1
    [ -n "$line" ] || return 1
    printf '%s\n' "${line#*=}"
}

# Écrit (ou remplace) une variable dans un fichier .env.
set_env_value() {
    local file="$1" var="$2" value="$3"
    if /usr/bin/grep -q "^${var}=" "$file" 2>/dev/null; then
        sed -i "s|^${var}=.*|${var}=${value}|" "$file" || return 1
    else
        printf '%s=%s\n' "$var" "$value" >> "$file" || return 1
    fi
}

# Variable IMG_ pilotant un service (vide si le service n'est pas piloté).
service_img_var() {
    local svc="$1" entry
    for entry in "${SERVICE_IMG_MAP[@]}"; do
        [ "${entry%%=*}" = "$svc" ] || continue
        printf '%s\n' "${entry#*=}"
        return 0
    done
    return 1
}

# Le service fait-il partie de la table ?
service_is_known() {
    local svc="$1" entry
    for entry in "${SERVICE_IMG_MAP[@]}"; do
        [ "${entry%%=*}" = "$svc" ] && return 0
    done
    return 1
}

# Noms de tous les services pilotés par versions.env (un par ligne).
all_service_names() {
    local entry
    for entry in "${SERVICE_IMG_MAP[@]}"; do
        printf '%s\n' "${entry%%=*}"
    done
}

# La valeur est-elle déjà dans la liste ?
var_in_list() {
    local needle="$1" item
    shift
    for item in "$@"; do
        [ "$item" = "$needle" ] && return 0
    done
    return 1
}

# Variables IMG_ de versions.env absentes de la table du script.
img_vars_not_covered() {
    local var known missing="" known_var
    while IFS= read -r var; do
        [ -n "$var" ] || continue
        known=0
        while IFS= read -r known_var; do
            [ "$known_var" = "$var" ] && { known=1; break; }
        done <<< "$EXPECTED_IMG_VARS"
        [ "$known" -eq 1 ] || missing="$missing $var"
    done < <(/usr/bin/grep -oE '^IMG_[A-Z0-9_]+' versions.env 2>/dev/null)
    printf '%s' "$missing"
}

# Vérifications préalables à une mise à jour.
update_preconditions() {
    if [ ! -f versions.env ]; then
        echo "❌ versions.env introuvable dans $(pwd)" >&2
        return 1
    fi
    if ! command -v docker >/dev/null 2>&1; then
        echo "❌ docker absent du PATH : mise à jour impossible" >&2
        return 1
    fi
    local missing
    missing=$(img_vars_not_covered)
    if [ -n "$missing" ]; then
        echo "❌ variables IMG_ de versions.env non pilotées par la table du script :${missing}" >&2
        echo "   complète SERVICE_IMG_MAP dans ./stack puis relance la mise à jour" >&2
        return 1
    fi
    return 0
}

# Construit la liste des services à mettre à jour (UPDATE_TARGETS).
# Erreur explicite + liste des services acceptés si un nom est inconnu.
build_update_targets() {
    UPDATE_TARGETS=()
    local svc
    if [ "$#" -eq 0 ]; then
        while IFS= read -r svc; do
            [ -n "$svc" ] && UPDATE_TARGETS+=("$svc")
        done < <(all_service_names)
    else
        for svc in "$@"; do
            if ! service_is_known "$svc"; then
                echo "❌ service inconnu : « $svc »" >&2
                echo "   services acceptés :" >&2
                all_service_names | sed 's/^/     - /' >&2
                return 1
            fi
            UPDATE_TARGETS+=("$svc")
        done
    fi
    return 0
}

# Usage de ./stack update.
update_usage() {
    cat <<'USAGE'
Usage: ./stack update [--dry-run] [service...]

Met à jour les images des services indiqués (tous les services si aucun nom
n'est donné) : recherche d'une version plus récente dans le registre, écriture
dans versions.env, pull de l'image, recréation des conteneurs, test de santé.
En cas d'échec du test de santé, versions.env est restauré (rollback).

  --dry-run   affiche les versions trouvées sans rien modifier
  -h, --help  cette aide

Services acceptés (une variable IMG_ par service) :
USAGE
    all_service_names | sed 's/^/  - /'
}

# Découpe "repo:tag" -> dépôt et tag (échoue sur un digest ou un tag absent).
split_image_tag() {
    local image="$1" repo tag
    case "$image" in
        *@*) return 1 ;;
    esac
    if [[ "$image" == *:* ]]; then
        repo="${image%:*}"
        tag="${image##*:}"
    else
        return 1
    fi
    [ -n "$tag" ] || return 1
    printf '%s %s\n' "$repo" "$tag"
}

# Hôte du registre et chemin du dépôt pour une référence sans tag.
registry_parts() {
    local repo="$1" host path
    case "$repo" in
        */*)
            if [[ "${repo%%/*}" == *.* || "${repo%%/*}" == *:* ]]; then
                host="${repo%%/*}"
                path="${repo#*/}"
            else
                host="registry-1.docker.io"
                path="$repo"
            fi
            ;;
        *)
            host="registry-1.docker.io"
            path="library/$repo"
            ;;
    esac
    printf '%s %s\n' "$host" "$path"
}

# Tags publiés pour un dépôt.
# Docker Hub : API Hub (tags les plus récemment mis à jour en premier).
# Autres registres : API OCI, par lots de 1000 tags.
registry_tags() {
    local host="$1" path="$2"
    if [ "$host" = "registry-1.docker.io" ]; then
        registry_tags_hub "$path"
        return $?
    fi
    registry_tags_oci "$host" "$path"
}

# Tags d'un dépôt Docker Hub (ordre : dernière mise à jour décroissante).
registry_tags_hub() {
    local path="$1" page=1 body names
    while [ "$page" -le 3 ]; do
        body=$(curl -sS --max-time 25 "https://registry.hub.docker.com/v2/repositories/${path}/tags?page_size=100&page=${page}" 2>/dev/null) || return 1
        names=$(printf '%s' "$body" | json_hub_tags)
        [ -n "$names" ] || return 0
        printf '%s\n' "$names"
        printf '%s' "$body" | json_hub_has_next || return 0
        page=$((page + 1))
    done
    return 0
}

# Tags d'un dépôt OCI (registre autre que Docker Hub), par lots de 1000.
registry_tags_oci() {
    local host="$1" path="$2" body tags challenge realm service authtok page="" count=0
    while : ; do
        if [ -z "$page" ]; then
            body=$(curl -sS --max-time 25 "https://${host}/v2/${path}/tags/list?n=1000" 2>/dev/null) || return 1
        else
            body=$(curl -sS --max-time 25 "https://${host}/v2/${path}/tags/list?n=1000&last=${page}" 2>/dev/null) || return 1
        fi
        tags=$(printf '%s' "$body" | json_tags)
        if [ -z "$tags" ]; then
            # Accès refusé : on récupère le jeton anonyme proposé par le registre.
            challenge=$(curl -sS -i -L --max-time 20 "https://${host}/v2/" 2>/dev/null | /usr/bin/grep -i '^www-authenticate:' | head -1)
            realm=$(printf '%s' "$challenge" | sed -n 's/.*realm="\([^"]*\)".*/\1/p')
            service=$(printf '%s' "$challenge" | sed -n 's/.*service="\([^"]*\)".*/\1/p')
            [ -n "$realm" ] || return 1
            authtok=$(curl -sS --max-time 20 "${realm}?service=${service}&scope=repository:${path}:pull" 2>/dev/null | json_token)
            [ -n "$authtok" ] || return 1
            body=$(curl -sS --max-time 25 -H "Authorization: Bearer ${authtok}" "https://${host}/v2/${path}/tags/list?n=1000" 2>/dev/null) || return 1
            tags=$(printf '%s' "$body" | json_tags)
        fi
        [ -n "$tags" ] || return 0
        printf '%s\n' "$tags"
        count=$(printf '%s\n' "$tags" | wc -l)
        [ "$count" -ge 1000 ] || return 0
        page=$(printf '%s\n' "$tags" | tail -1)
        [ -n "$page" ] || return 0
    done
}

# "Forme" d'un tag : chaque suite de chiffres remplacée par # (17.11 -> #.#).
tag_shape() {
    printf '%s' "$1" | sed -E 's/[0-9]+/#/g'
}

# Composantes numériques d'un tag ("17.11" -> "17 11").
tag_numbers() {
    printf '%s' "$1" | /usr/bin/grep -oE '[0-9]+' | tr '\n' ' '
}

# Composante majeure d'un tag (1re composante numérique). Vide si le tag
# n'a qu'un seul numéro (numéro de build : server-cuda-b11206).
tag_major() {
    local nums
    nums=$(tag_numbers "$1")
    set -- $nums
    [ "$#" -ge 2 ] || return 0
    printf '%s' "$1"
}

# Tag (sans le dépôt) d'une référence d'image.
image_tag() {
    local image="$1"
    case "$image" in *@*) return 1 ;; esac
    printf '%s' "${image##*:}"
}

# Mention d'avertissement quand la version majeure change.
major_note() {
    local a b
    a=$(tag_major "$(image_tag "$1")")
    b=$(tag_major "$(image_tag "$2")")
    if [ -n "$a" ] && [ -n "$b" ] && [ "$a" != "$b" ]; then
        printf '  ⚠️ version majeure (%s → %s)' "$a" "$b"
    fi
}

# Le tag candidat est-il strictement plus récent que le tag courant ?
# Même forme exigée (mêmes littéraux, même nombre de composantes) : un tag
# flottant ou d'une autre série n'est jamais proposé.
tag_is_newer() {
    local cand="$1" cur="$2"
    [ "$cand" != "$cur" ] || return 1
    [ "$(tag_shape "$cand")" = "$(tag_shape "$cur")" ] || return 1
    local -a cn nn
    read -r -a cn <<< "$(tag_numbers "$cand")"
    read -r -a nn <<< "$(tag_numbers "$cur")"
    [ "${#cn[@]}" -eq "${#nn[@]}" ] || return 1
    local i
    for (( i = 0; i < ${#cn[@]}; i++ )); do
        if (( 10#${cn[i]} > 10#${nn[i]} )); then return 0; fi
        if (( 10#${cn[i]} < 10#${nn[i]} )); then return 1; fi
    done
    return 1
}

# Cherche une image strictement plus récente pour une référence "repo:tag".
# Une version de la même série majeure est préférée ; à défaut, la plus haute
# version disponible est retenue (le changement de majeure est signalé).
# Retourne la nouvelle référence complète, ou vide si rien de plus récent.
find_newer_image() {
    local image="$1" repo tag host path cand tags
    local best="" best_same="" cur_major cand_major
    read -r repo tag < <(split_image_tag "$image") || return 0
    [ -n "$tag" ] || return 0
    read -r host path < <(registry_parts "$repo")
    tags=$(registry_tags "$host" "$path") || return 0
    [ -n "$tags" ] || return 0
    cur_major=$(tag_major "$tag")
    while IFS= read -r cand; do
        [ -n "$cand" ] || continue
        tag_is_newer "$cand" "$tag" || continue
        if [ -z "$best" ] || tag_is_newer "$cand" "$best"; then
            best="$cand"
        fi
        cand_major=$(tag_major "$cand")
        if [ -n "$cur_major" ] && [ "$cand_major" = "$cur_major" ]; then
            if [ -z "$best_same" ] || tag_is_newer "$cand" "$best_same"; then
                best_same="$cand"
            fi
        fi
    done <<< "$tags"
    if [ -n "$best_same" ]; then
        best="$best_same"
    elif [ "$SAME_MAJOR_ONLY" -eq 1 ]; then
        return 0
    fi
    [ -n "$best" ] || return 0
    printf '%s:%s\n' "$repo" "$best"
}

# Restauration après échec : versions.env remis à l'état sauvegardé et
# conteneurs recréés avec les versions précédentes. La sauvegarde est conservée.
rollback_update() {
    local backup_dir="$1"
    echo "↩️  rollback : restauration de versions.env depuis $backup_dir/versions.env.snapshot"
    cp "$backup_dir/versions.env.snapshot" versions.env || { echo "❌ restauration de versions.env impossible" >&2; return 1; }
    if [ "${#UPDATE_CHANGED_SERVICES[@]}" -gt 0 ]; then
        echo "↩️  rollback : recréation des conteneurs avec les versions précédentes"
        docker compose --env-file versions.env --env-file .env up -d "${UPDATE_CHANGED_SERVICES[@]}" >/dev/null 2>&1 || true
    fi
    echo "❌ mise à jour annulée : versions.env restauré"
    echo "   sauvegarde conservée : $backup_dir/versions.env.snapshot"
    return 1
}

# ./stack versions — versions déclarées puis conteneurs en cours.
cmd_versions() {
    echo "📦 Versions déclarées (versions.env)"
    echo "===================================="
    if [ ! -f versions.env ]; then
        echo "❌ versions.env introuvable dans $(pwd)" >&2
        return 1
    fi
    local line
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        case "$line" in *=*) ;; *) continue ;; esac
        printf '  %-22s %s\n' "${line%%=*}" "${line#*=}"
    done < versions.env
    echo ""
    echo "🐳 Conteneurs (service / image / état)"
    echo "--------------------------------------"
    if ! command -v docker >/dev/null 2>&1; then
        echo "  ⚠️  docker absent du PATH : état des conteneurs indisponible"
        return 0
    fi
    local ps_json rows
    ps_json=$(docker compose --env-file versions.env --env-file .env ps -a --format json 2>/dev/null || true)
    if [ -z "$ps_json" ]; then
        echo "  ℹ️  aucun conteneur : la stack n'est pas démarrée"
        return 0
    fi
    if [ "$JSON_TOOL" = "jq" ]; then
        rows=$(printf '%s\n' "$ps_json" | jq -s -r 'flatten | .[] | select(type == "object") | [.Service, .Image, .State, (.Health // "-")] | @tsv' 2>/dev/null || true)
    elif [ "$JSON_TOOL" = "python3" ]; then
        rows=$(printf '%s\n' "$ps_json" | python3 -c "
import json, sys
raw = sys.stdin.read().strip()
if not raw:
    sys.exit(0)
try:
    data = json.loads(raw)
except ValueError:
    data = [json.loads(line) for line in raw.splitlines() if line.strip()]
for item in (data if isinstance(data, list) else [data]):
    if not isinstance(item, dict):
        continue
    print('\t'.join([
        str(item.get('Service') or '-'),
        str(item.get('Image') or '-'),
        str(item.get('State') or '-'),
        str(item.get('Health') or '-'),
    ]))
" 2>/dev/null || true)
    else
        rows=$(docker compose --env-file versions.env --env-file .env ps -a --format '{{.Service}} {{.Image}} {{.State}}' 2>/dev/null || true)
    fi
    if [ -z "$rows" ]; then
        echo "  ℹ️  aucun conteneur : la stack n'est pas démarrée"
        return 0
    fi
    printf '  %-18s %-46s %-10s %s\n' "SERVICE" "IMAGE" "ETAT" "SANTE"
    local svc img state health
    while IFS=$'\t' read -r svc img state health; do
        [ -n "$svc" ] || continue
        printf '  %-18s %-46s %-10s %s\n' "$svc" "$img" "$state" "${health:-}"
    done <<< "$rows"
    return 0
}

# ./stack update — met à jour réellement les images, avec rollback.
cmd_update() {
    local dry_run=0
    local -a requested=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dry-run) dry_run=1; shift ;;
            --same-major-only) SAME_MAJOR_ONLY=1; shift ;;
            -h|--help) update_usage; return 0 ;;
            -*) echo "❌ option inconnue : $1" >&2; update_usage >&2; return 2 ;;
            *) requested+=("$1"); shift ;;
        esac
    done
    update_preconditions || return 2
    build_update_targets "${requested[@]}" || return 2
    local -a targets=("${UPDATE_TARGETS[@]}")
    local backup_dir
    backup_dir=$(mktemp -d "${TMPDIR:-/tmp}/stack-update-XXXXXX") || { echo "❌ répertoire de sauvegarde impossible" >&2; return 1; }
    echo "🔄 Mise à jour de la stack"
    echo "=========================="
    echo "1/5 — sauvegarde de versions.env"
    cp versions.env "$backup_dir/versions.env.snapshot" || { echo "❌ sauvegarde impossible" >&2; return 1; }
    echo "    💾 $backup_dir/versions.env.snapshot (conservée jusqu'au test de santé réussi : rollback possible)"
    echo "2/5 — recherche de versions plus récentes"
    local svc var cur newimg
    UPDATE_CHANGED_SERVICES=()
    UPDATED_VARS=()
    for svc in "${targets[@]}"; do
        var=$(service_img_var "$svc" || true)
        cur=$(env_file_value versions.env "$var" || true)
        if [ -z "$var" ] || [ -z "$cur" ]; then
            echo "    ⚠️  $svc : image non pilotée par versions.env — ignoré"
            continue
        fi
        if var_in_list "$var" "${UPDATED_VARS[@]}"; then
            echo "    • $svc ($var) : image déjà mise à jour (même variable)"
            UPDATE_CHANGED_SERVICES+=("$svc")
            continue
        fi
        newimg=$(find_newer_image "$cur" || true)
        if [ -z "$newimg" ]; then
            echo "    • $svc ($var) : $cur — aucune version plus récente vérifiable"
            continue
        fi
        echo "    • $svc ($var) : ${cur} → ${newimg}$(major_note "$cur" "$newimg")"
        [ "$dry_run" -eq 1 ] && continue
        set_env_value versions.env "$var" "$newimg" || { echo "❌ écriture impossible dans versions.env" >&2; rollback_update "$backup_dir"; return 1; }
        echo "    ↓ pull $svc ($newimg)"
        docker compose --env-file versions.env --env-file .env pull "$svc" >/dev/null 2>&1 || { echo "❌ pull impossible pour $svc ($newimg)" >&2; rollback_update "$backup_dir"; return 1; }
        UPDATED_VARS+=("$var")
        UPDATE_CHANGED_SERVICES+=("$svc")
    done
    if [ "${#UPDATE_CHANGED_SERVICES[@]}" -eq 0 ] || [ "$dry_run" -eq 1 ]; then
        [ "$dry_run" -eq 1 ] && echo "    (simulation : versions.env non modifié)" || echo "✅ Aucune version plus récente à appliquer"
        rm -rf "$backup_dir"
        return 0
    fi
    echo "3/5 — recréation des conteneurs concernés"
    docker compose --env-file versions.env --env-file .env up -d "${UPDATE_CHANGED_SERVICES[@]}" || { echo "❌ recréation impossible" >&2; rollback_update "$backup_dir"; return 1; }
    echo "4/5 — test de santé (test-stack.sh)"
    local health=0
    ./test-stack.sh --wait "${STACK_UPDATE_WAIT:-120}" || health=$?
    if [ "$health" -ne 0 ]; then
        echo "5/5 — test de santé en échec : rollback"
        rollback_update "$backup_dir"
        return 1
    fi
    echo "5/5 — test de santé réussi : sauvegarde supprimée"
    rm -rf "$backup_dir"
    echo "✅ Mise à jour terminée"
    return 0
}

# Routage des sous-commandes propres au script (doctor est traité plus haut).
case "${1:-}" in
    versions)
        cmd_versions
        exit $?
        ;;
    update)
        shift
        cmd_update "$@"
        exit $?
        ;;
esac

# Default: pass through to docker compose
exec docker compose --env-file versions.env --env-file .env "$@"
